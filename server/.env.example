# Copy to .env and fill for local development:
#   copy .env.example .env   (Windows) or  cp .env.example .env  (Git Bash)

PORT=4000

# Local PostgreSQL (use this when running Docker Compose from /server)
DATABASE_URL="postgresql://cte:cte_local_dev@localhost:5432/ciarleglio?schema=public"

# Session signing (required for login cookies). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-char-hex-or-long-random-string

# Optional: first user can be ADMIN without this; set for admin API access
ADMIN_TOKEN=dev-admin-token-change-in-production

# Optional: only needed for image upload to Supabase (inventory CRUD works without)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=inventory-images

# Optional: email (verification / forgot password)
# MAIL_HOST= MAIL_PORT=587 MAIL_USER= MAIL_PASS= MAIL_FROM=
# FRONTEND_BASE_URL=http://localhost:4000
